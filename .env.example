# Postgres connection string (Neon in production, local Postgres in development)
DATABASE_URL=postgres://user:password@localhost:5432/rental_guarantee

# Random 32+ character string used to sign session cookies
AUTH_SECRET=change-me-to-a-long-random-string

# Stellar network (testnet by default; the MVP never targets mainnet)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Testnet USDC. STELLAR_USDC_CONTRACT_ID is the Stellar Asset Contract address
STELLAR_USDC_CODE=USDC
STELLAR_USDC_ISSUER=
STELLAR_USDC_CONTRACT_ID=

# Deployed Soroban escrow contract. Empty => the app runs in simulated demo mode
SOROBAN_CONTRACT_ID=

# Account that submits release transactions. Never a user key
PLATFORM_SECRET_KEY=

# Testnet-only throwaway keys used by the scripted demo (comma separated)
DEMO_SIGNER_SECRETS=

NEXT_PUBLIC_DEMO_MODE=true

# Authenticates the /api/cron/expire endpoint that Vercel Cron calls daily
# (see vercel.json). Generate with `openssl rand -hex 32`; the endpoint
# refuses every request until this is set.
CRON_SECRET=
